{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=DonationHubDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SecretKey": "REPLACE_WITH_YOUR_SECRET_KEY",
    "Issuer": "DonationHubApi",
    "Audience": "DonationHubClient",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "SeedAdmin": {
    "Email": "REPLACE_WITH_YOUR_EMAIL",
    "Password": "REPLACE_WITH_SECURE_PASSWORD",
    "FullName": "System Administrator"
  },
  "Donation": {
    "MinAmount": 1.00,
    "MaxAmount": 10000.00,
    "PendingTimeoutMinutes": 30,
    "DefaultCurrency": "USD"
  },
  "SeedSettings": {
    "Admin": {
      "Email": "admin@donationhub.com",
      "Password": "REPLACE_WITH_SECURE_PASSWORD"
    },
    "CampaignManager": {
      "Email": "manager@donationhub.com",
      "Password": "REPLACE_WITH_SECURE_PASSWORD"
    },
    "Donor": {
      "Email": "donor@donationhub.com",
      "Password": "REPLACE_WITH_SECURE_PASSWORD"
    }
  }
}